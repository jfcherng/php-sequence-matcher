{
    "name": "jfcherng/php-sequence-matcher",
    "description": "A longest sequence matcher. The logic is primarily based on the Python difflib package.",
    "type": "library",
    "license": "BSD-3-Clause",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jack Cherng",
            "email": "jfcherng@gmail.com"
        },
        {
            "name": "Chris Boulton",
            "email": "chris.boulton@interspire.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Jfcherng\\Diff\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jfcherng\\Diff\\Test\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phan/phan": "^6",
        "phpunit/phpunit": "^12",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true
    },
    "scripts": {
        "analyze": [
            "phan --color",
            "phpcs --colors -n"
        ],
        "fix": [
            "php-cs-fixer fix --verbose"
        ],
        "test": [
            "phpunit --display-deprecations --display-errors --display-incomplete --display-skipped --display-warnings"
        ]
    }
}
